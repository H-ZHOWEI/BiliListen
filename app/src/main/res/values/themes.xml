<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BiliListen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/bili_pink</item>
        <item name="colorOnPrimary">#2A0A14</item>
        <item name="colorPrimaryContainer">#4A1727</item>
        <item name="colorOnPrimaryContainer">#FFD9E4</item>
        <item name="colorSecondary">@color/bili_blue</item>
        <item name="colorOnSecondary">#00161F</item>
        <item name="colorSecondaryContainer">#0E3D52</item>
        <item name="colorOnSecondaryContainer">#C4E9FA</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorOnSurface">@color/on_bg</item>
        <item name="colorOnSurfaceVariant">@color/on_bg_dim</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/on_bg</item>
    </style>

    <style name="TextAppearance.BiliListen.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/on_bg</item>
    </style>

    <style name="TextAppearance.BiliListen.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_bg_dim</item>
    </style>

    <style name="Widget.BiliListen.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">#33FB7299</item>
    </style>

    <style name="Widget.BiliListen.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/bili_pink</item>
        <item name="android:textColor">#2A0A14</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.BiliListen.TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/surface_high</item>
        <item name="android:textColor">@color/on_bg</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
