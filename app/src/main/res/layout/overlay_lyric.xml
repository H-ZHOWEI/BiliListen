<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyric_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_lyric_overlay"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="9dp">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_eq"
        android:tint="@color/bili_pink"
        android:contentDescription="拖动" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lyric_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/on_bg"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="歌词" />

        <TextView
            android:id="@+id/lyric_text_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/on_bg_dim"
            android:textSize="11.5sp"
            android:text="下一句"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
